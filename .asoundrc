# Force ALSA default capture device to the Logitech C615 webcam.
# This overrides the onboard ALC897 and survives card-number reordering
# because it uses the card name rather than the index.
#
# To find your capture card name on the host, run: arecord -l
# Look for the line: card X: NAME [Human Readable Name]
# Use the NAME (e.g. C615) in the "card" field below.

pcm.!default {
    type asym
    playback.pcm "null"
    capture.pcm "webcam"
}

pcm.webcam {
    type hw
    card C615
    device 0
}

ctl.!default {
    type hw
    card C615
}
