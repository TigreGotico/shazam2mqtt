# Example environment file for docker-compose.
# Copy this to .env and fill in your values.

DEVICE_NAME=living_room
MQTT_HOST=192.168.1.200
MQTT_PORT=1883
MQTT_USER=mqtt
MQTT_PASS=secret

NOISE_GATE_DB=-40
LISTEN_DURATION=10
COOLDOWN_SECONDS=60
SAME_SONG_COOLDOWN_SECONDS=300

HA_DISCOVERY_PREFIX=homeassistant
HA_ENABLED=true
